#!/system/bin/sh
# Extra Dim (Reduce Bright Colors) for Android 8 - 17+
# Made with ❤️ by t.me/Shivraj_editx
#
# Two engines, picked automatically on every call:
#   native  Android 12+ ROMs whose framework reports "Reduce bright colors" as available
#           (dumpsys color_display): drives the real Extra Dim settings, so the system composes
#           it with Night Light etc. and handles restarts itself.
#   sf      everything else (Android 8-11, and Android 12+ ROMs where it is missing or reported
#           "Not available"): pushes the same colour matrix AOSP's DisplayTransformManager sends
#           to SurfaceFlinger (binder transaction 1015).
# Nothing is patched in /system; this helper only runs when called (tile, shell, boot script). A restart
# returns the screen to normal unless "persist" (keep on after restart) is switched on.
#
#USAGE-START
#   extradim on [0-100]   turn on (optionally set intensity; higher = dimmer)
#   extradim off
#   extradim toggle
#   extradim level N      set intensity, re-applies live if on
#   extradim persist 0|1  keep on after restart (default: off after restart)
#   extradim status       state, engine, Android API
#   extradim test [gpu]   dim for 3 seconds then restore (add gpu to try it with GPU composition)
#   extradim check        is the dim offloaded to the display controller? (battery check)
#   extradim engine sf|auto   pick the engine (auto = native Extra Dim when the ROM really has it)
#   extradim gpu on|off|status  force GPU composition while dimmed (fixes ROMs whose display driver
#                         ignores colour transforms: the matrix shows in `diag` but nothing dims)
#   extradim diag [probe] print a diagnostic report - paste it when something doesn't work
#
# Optional tuning: /data/adb/extradim/config   (KEY=VALUE lines)
#   ENGINE=auto|sf                force the SurfaceFlinger engine (default auto)
#   CURVE=nonlinear|linear|auto   sf engine only; default nonlinear (gamma-safe)
#   MINF=100                      sf engine only; darkest per-channel factor, in thousandths
#   GPU=0|1                       1 = force GPU composition while dimmed (same as `extradim gpu on`)
#USAGE-END

DATA=${EXTRADIM_DATA:-/data/adb/extradim}
STATE=$DATA/state
CONF=$DATA/config

die() { echo "extradim: $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "needs root  (su -c 'extradim help')"
mkdir -p "$DATA" 2>/dev/null && chmod 700 "$DATA" 2>/dev/null

API=$(getprop ro.build.version.sdk 2>/dev/null)
case "$API" in ''|*[!0-9]*) API=0 ;; esac

ON=0
LEVEL=40
PERSIST=0
BOOT=
CURVE=nonlinear
MINF=100
ENGINE=auto
GPU=0

load_file() {
  [ -f "$1" ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in
      ON|LEVEL|PERSIST|MINF|BOOT|GPU)
        case "$v" in ''|*[!0-9]*) ;; *) eval "$k=$v" ;; esac ;;
      CURVE)
        case "$v" in auto|linear|nonlinear) CURVE=$v ;; esac ;;
      ENGINE)
        case "$v" in auto|sf) ENGINE=$v ;; esac ;;
    esac
  done < "$1"
}
load_file "$CONF"
load_file "$STATE"

# Android 12+ only. The framework's real Extra Dim prints "Reduce bright colors:" followed by
# " Activated: ..." when it is available and " Not available" when the ROM/HWC did not enable it.
# When it is NOT available its colour transform is not set up, so writing its settings keys could
# black out the screen: they are only ever written when this says available.
native_available() {
  [ "$API" -ge 31 ] || return 1
  dumpsys color_display 2>/dev/null | sed -n '/^Reduce bright colors:/,/^Color mode:/p' | grep -q 'Activated:'
}
# prints true / false / unknown: does the framework's Extra Dim say it is activated right now?
native_activated() {
  v=$(dumpsys color_display 2>/dev/null | sed -n '/^Reduce bright colors:/,/^Color mode:/p' \
      | grep -m1 'Activated:' | sed 's/.*Activated:[[:space:]]*//' | tr -d '[:space:]')
  case "$v" in true|false) echo "$v" ;; *) echo unknown ;; esac
}

set_config() { # KEY VALUE  (keeps the other lines of the config)
  mkdir -p "$DATA" 2>/dev/null
  { [ -f "$CONF" ] && grep -v "^$1=" "$CONF"; echo "$1=$2"; } > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
}
set_engine_config() { set_config ENGINE "$1"; }

# Some ROMs hand colour transforms to a display driver that silently ignores them: SurfaceFlinger holds
# the matrix (see `extradim diag`) but nothing dims. Forcing GPU composition makes SurfaceFlinger apply
# it itself. It is the same switch as Developer options -> "Disable HW overlays" (binder code 1008), and
# we only ever undo it if we set it.
gpu_force() { # 1 = force GPU composition, 0 = give it back (only if we forced it)
  if [ "$1" = "1" ]; then
    service call SurfaceFlinger 1008 i32 1 >/dev/null 2>&1 && touch "$DATA/gpu_forced"
  elif [ -f "$DATA/gpu_forced" ]; then
    service call SurfaceFlinger 1008 i32 0 >/dev/null 2>&1
    rm -f "$DATA/gpu_forced"
  fi
}
gpu_sync() { if [ "$GPU" = "1" ] && [ "$ON" = "1" ]; then gpu_force 1; else gpu_force 0; fi; }

ENG=sf
case "$1" in
  help|-h|--help|'') ;;
  *) if [ "$ENGINE" != "sf" ] && native_available; then ENG=native; fi ;;
esac

# Settings.Global boot_count changes on every restart. A dim turned on in an earlier boot is
# already gone, so unless "persist" is on, stale state reads as off.
bootno() {
  v=$(settings get global boot_count 2>/dev/null)
  case "$v" in ''|*[!0-9]*) echo "" ;; *) echo "$v" ;; esac
}
NOW=$(bootno)
STALE=0
if [ "$ON" = "1" ] && [ "$PERSIST" != "1" ] && [ -n "$NOW" ] && [ -n "$BOOT" ] && [ "$BOOT" != "$NOW" ]; then
  ON=0
  STALE=1
fi

save() {
  printf 'ON=%s\nLEVEL=%s\nPERSIST=%s\nBOOT=%s\n' "$ON" "$LEVEL" "$PERSIST" "$NOW" > "$STATE.tmp" \
    && mv "$STATE.tmp" "$STATE"
}

# What the tile app reads (no root needed on its side).
mirror() {
  settings put secure extradim_on "$ON" >/dev/null 2>&1
  settings put secure extradim_level "$LEVEL" >/dev/null 2>&1
  settings put secure extradim_persist "$PERSIST" >/dev/null 2>&1
  [ -n "$NOW" ] && settings put secure extradim_boot "$NOW" >/dev/null 2>&1
  # Android 8-11: tile app v1.0 reads AOSP's key names and no framework code reacts to them.
  # Android 12+: those names belong to the real Extra Dim and are never written from here
  # except by the native engine (native_set), and only when the framework says it is available.
  if [ "$API" -gt 0 ] && [ "$API" -le 30 ]; then
    settings put secure reduce_bright_colors_activated "$ON" >/dev/null 2>&1
    settings put secure reduce_bright_colors_level "$LEVEL" >/dev/null 2>&1
  fi
}

# AOSP rule (DisplayTransformManager.needsLinearColorMatrix): matrices are applied in linear
# space unless the display is in the unmanaged "saturated" mode (persist.sys.sf.native_mode=1).
pick_curve() {
  case "$CURVE" in
    linear|nonlinear) echo "$CURVE" ;;
    *) if [ "$(getprop persist.sys.sf.native_mode)" = "1" ]; then echo nonlinear; else echo linear; fi ;;
  esac
}

# strength 0..100 -> per-channel factor in thousandths. Coefficients are the AOSP
# config_reduceBrightColorsCoefficients (linear) / ...Nonlinear sets: a*s^2 + b*s + c, s=strength/100.
factor() {
  s=$1
  if [ "$2" = "nonlinear" ]; then
    f=$(( (-443 * s * s) / 10000 + (-243 * s) / 100 + 981 ))
  else
    f=$(( 1000 - (956 * s) / 100 ))
  fi
  [ "$f" -lt "$MINF" ] && f=$MINF
  [ "$f" -gt 1000 ] && f=1000
  echo "$f"
}

fmt() { printf '%d.%03d' $(( $1 / 1000 )) $(( $1 % 1000 )); }

sf_matrix() {
  out=$(service call SurfaceFlinger 1015 i32 1 \
    f "$1" f 0 f 0 f 0 \
    f 0 f "$1" f 0 f 0 \
    f 0 f 0 f "$1" f 0 \
    f 0 f 0 f 0 f 1 2>&1)
  case "$out" in
    *rror*|*enied*|*"not exist"*|*"not found"*)
      echo "extradim: SurfaceFlinger call failed: $out" >&2
      return 1 ;;
  esac
  return 0
}

sf_reset() { service call SurfaceFlinger 1015 i32 0 >/dev/null 2>&1; }

# native engine: flip the real Extra Dim settings (level first, then the switch)
native_set() {
  settings put secure reduce_bright_colors_level "$2" >/dev/null 2>&1
  settings put secure reduce_bright_colors_activated "$1" >/dev/null 2>&1
  return 0
}

# make the screen match the saved state
apply() {
  apply_engine
  rc=$?
  gpu_sync
  return $rc
}

apply_engine() {
  if [ "$ENG" = "native" ]; then
    native_set "$ON" "$LEVEL"
    if [ "$ON" = "1" ]; then
      a=$(native_activated)
      if [ "$a" = "false" ]; then sleep 1; a=$(native_activated); fi
      if [ "$a" = "false" ]; then
        # the framework accepted the settings but did not activate Extra Dim: use SurfaceFlinger instead
        echo "extradim: this ROM's Extra Dim did not activate - switching to the SurfaceFlinger engine (extradim engine auto to undo)" >&2
        native_set 0 "$LEVEL"
        set_engine_config sf
        ENG=sf
        f=$(factor "$LEVEL" "$(pick_curve)")
        sf_matrix "$(fmt "$f")"
        return $?
      fi
    fi
  elif [ "$ON" = "1" ]; then
    f=$(factor "$LEVEL" "$(pick_curve)")
    sf_matrix "$(fmt "$f")"
  else
    sf_reset
  fi
}

# dim at a given level without touching the saved state (for test/check)
dim_test_on() {
  if [ "$ENG" = "native" ]; then
    native_set 1 "$1"
  else
    f=$(factor "$1" "$(pick_curve)")
    sf_matrix "$(fmt "$f")"
  fi
  rc=$?
  [ "$GPU" = "1" ] && gpu_force 1
  return $rc
}

num() {
  case "$1" in ''|*[!0-9]*) die "not a number: '$1'" ;; esac
  [ "$1" -le 100 ] || die "range is 0-100"
}

report() { if [ "$ON" = "1" ]; then echo "on $LEVEL"; else echo "off $LEVEL"; fi; }

turn_on() {
  ON=1
  if ! apply; then ON=0; save; mirror; exit 1; fi
}

# Counts how many on-screen layers SurfaceFlinger hands to the display controller (DEVICE)
# vs. composes on the GPU (CLIENT), straight from `dumpsys SurfaceFlinger`.
comp_counts() {
  d=$(dumpsys SurfaceFlinger 2>/dev/null)
  dev=$(printf '%s\n' "$d" | grep -cE '\| +DEVICE +\|')
  cli=$(printf '%s\n' "$d" | grep -cE '\| +CLIENT +\|')
  echo "$dev $cli"
}

case "$1" in
  on)
    if [ -n "$2" ]; then num "$2"; LEVEL=$2; fi
    turn_on; save; mirror; report ;;
  off)
    ON=0; apply; save; mirror; report ;;
  toggle)
    if [ "$ON" = "1" ]; then ON=0; apply; else turn_on; fi
    save; mirror; report ;;
  level)
    num "$2"; LEVEL=$2
    if [ "$ON" = "1" ]; then apply || { ON=0; }; elif [ "$ENG" = "native" ]; then native_set 0 "$LEVEL"; fi
    save; mirror; report ;;
  persist)
    case "$2" in 0|1) PERSIST=$2 ;; *) die "persist takes 0 or 1" ;; esac
    if [ "$ENG" = "native" ]; then
      settings put secure reduce_bright_colors_persist_across_reboots "$PERSIST" >/dev/null 2>&1
    fi
    save; mirror; report ;;
  status)
    if [ "$ENG" = "native" ]; then
      extra=""
    else
      c=$(pick_curve); f=$(factor "$LEVEL" "$c")
      extra=" curve=$c factor=$(fmt "$f") floor=$(fmt "$MINF")"
    fi
    echo "state=$([ "$ON" = "1" ] && echo on || echo off) level=$LEVEL persist=$PERSIST stale=$STALE engine=$ENG gpu=$GPU api=$API$extra" ;;
  test)
    [ "$2" = "gpu" ] && GPU=1
    echo "dimming for 3s (engine $ENG, level 60$([ "$GPU" = 1 ] && echo ', GPU composition')) ..."
    dim_test_on 60 || exit 1
    sleep 3
    apply
    echo "restored" ;;
  check)
    set -- $(comp_counts); d0=$1; c0=$2
    dim_test_on 60 || exit 1
    sleep 1
    set -- $(comp_counts); d1=$1; c1=$2
    apply
    echo "engine $ENG | layers DEVICE/CLIENT  before: $d0/$c0   with dim: $d1/$c1"
    if [ $((d0 + c0)) -eq 0 ]; then
      echo "can't tell (no layer table found in dumpsys SurfaceFlinger)"
    elif [ "$c1" -gt "$c0" ] && [ "$d1" -lt "$d0" ]; then
      echo "WARNING: dimming pushes layers to GPU composition (extra power; DRM video may blank). Leave it off on this panel."
    else
      echo "OK: layers stay on the display controller (HWC offload) - no extra GPU work."
    fi ;;
  gpu)
    case "$2" in
      on)  set_config GPU 1; GPU=1 ;;
      off) set_config GPU 0; GPU=0 ;;
      status|'') echo "gpu=$GPU forced_now=$([ -f "$DATA/gpu_forced" ] && echo yes || echo no)"; exit 0 ;;
      *) die "gpu takes on, off or status" ;;
    esac
    gpu_sync
    echo "GPU composition while dimmed: $([ "$GPU" = 1 ] && echo on || echo off)   (dim is $([ "$ON" = 1 ] && echo on || echo off))" ;;
  engine)
    case "$2" in sf|auto) ;; *) die "engine takes sf or auto" ;; esac
    # switch cleanly: turn the current effect off first so two engines never stack
    if [ "$ON" = "1" ]; then ON=0; apply; save; mirror; echo "dim turned off - tap again to use the new engine"; fi
    set_engine_config "$2"
    echo "engine set to $2" ;;
  diag)
    PKG=com.extradim.tile
    DE=/data/user_de/0/$PKG/files
    echo "== Extra Dim diag =="
    echo "module  : $(sed -n 's/^version=//p' /data/adb/modules/extradim/module.prop 2>/dev/null) / app_version $(cat /data/adb/modules/extradim/app_version 2>/dev/null)"
    echo "android : $(getprop ro.build.version.release) (API $API, $(getprop ro.build.version.codename)) $(getprop ro.product.manufacturer) $(getprop ro.product.device)"
    echo "rom     : $(getprop ro.build.display.id)   selinux: $(getenforce 2>/dev/null)"
    rm=""
    command -v magisk >/dev/null 2>&1 && rm="$rm magisk($(magisk -v 2>/dev/null | head -n 1))"
    if command -v ksud >/dev/null 2>&1 || [ -e /data/adb/ksud ]; then rm="$rm kernelsu-family($( (ksud -V || /data/adb/ksud -V) 2>/dev/null | head -n 1))"; fi
    [ -e /data/adb/apd ] && rm="$rm apatch"
    echo "root    :${rm:- unknown}"
    echo "engine  : $ENG  (config ENGINE=$ENGINE, native_available=$(native_available && echo yes || echo no), activated=$([ "$API" -ge 31 ] && native_activated || echo n/a))"
    echo "state   : on=$ON level=$LEVEL persist=$PERSIST stale=$STALE   gpu=$GPU forced_now=$([ -f "$DATA/gpu_forced" ] && echo yes || echo no)"
    echo "-- dumpsys color_display (head):"
    dumpsys color_display 2>/dev/null | sed -n '/^Night display:/,/^Color mode:/p' | head -n 22 | sed 's/^/   /'
    echo "-- SurfaceFlinger colour transform lines in its dump:"
    sfl=$(dumpsys SurfaceFlinger 2>/dev/null | grep -i -m3 -E 'colorTransform|color transform' | sed 's/^ *//' | cut -c1-150)
    if [ -n "$sfl" ]; then printf '%s\n' "$sfl" | sed 's/^/   /'; else echo "   (none found)"; fi
    caps=$(dumpsys SurfaceFlinger 2>/dev/null | grep -i -m4 -E 'skip_client_color_transform|SkipClientColorTransform|color transform' | sed 's/^ *//' | cut -c1-120)
    [ -n "$caps" ] && { echo "-- HWC colour-transform capability lines:"; printf '%s\n' "$caps" | sed 's/^/   /'; }
    echo "-- backlight nodes:"
    for b in /sys/class/leds/lcd-backlight /sys/class/backlight/*; do
      [ -d "$b" ] && echo "   $b: $(cat "$b/brightness" 2>/dev/null)/$(cat "$b/max_brightness" 2>/dev/null)"
    done
    if [ "$ON" = "1" ] && [ -n "$sfl" ]; then
      echo "-- hint: if the matrix above is not the identity but the screen did NOT dim, the display driver"
      echo "   ignores colour transforms (Android's own Extra Dim / Night Light fail too). Try: extradim gpu on"
    fi
    echo "-- settings:"
    for k in extradim_on extradim_level extradim_persist extradim_boot reduce_bright_colors_activated reduce_bright_colors_level reduce_bright_colors_persist_across_reboots; do
      echo "   $k=$(settings get secure $k 2>/dev/null)"
    done
    echo "   boot_count=$(settings get global boot_count 2>/dev/null)"
    echo "-- tile app:"
    echo "   path: $(pm path $PKG 2>/dev/null | head -n 1)   uid: $(stat -c %u /data/data/$PKG 2>/dev/null)"
    dumpsys package $PKG 2>/dev/null | grep -m2 -E 'versionName|versionCode' | sed 's/^ */   /'
    echo "-- listener (lets the app work without a root grant):"
    echo "   dir    : $(ls -ldZ "$DE" 2>/dev/null || echo missing)"
    echo "   marker : $(cat "$DE/.listener" 2>/dev/null || echo none)"
    echo "   procs  : $( (ps -A 2>/dev/null || ps 2>/dev/null) | grep -E 'inotifyd|fifo-loop' | grep -v grep | head -n 3 | tr -s ' ' | tr '\n' ';')"
    echo "   last cmd: $(cat "$DATA/last-command" 2>/dev/null)"
    echo "   boot.log:"; tail -n 14 "$DATA/boot.log" 2>/dev/null | sed 's/^/     /'
    if [ "$2" = "probe" ]; then
      echo "-- probe: raw SurfaceFlinger call (about 1 s dim, then your saved state is restored)"
      out=$(service call SurfaceFlinger 1015 i32 1 f 0.5 f 0 f 0 f 0 f 0 f 0.5 f 0 f 0 f 0 f 0 f 0.5 f 0 f 0 f 0 f 0 f 1 2>&1)
      echo "   service call -> $out"
      sleep 1
      sfl=$(dumpsys SurfaceFlinger 2>/dev/null | grep -i -m2 -E 'colorTransform|color transform' | sed 's/^ *//' | cut -c1-150)
      if [ -n "$sfl" ]; then printf '%s\n' "$sfl" | sed 's/^/   dump while dimmed: /'; else echo "   dump while dimmed: (no colour transform line)"; fi
      apply
    fi
    echo "== end ==" ;;
  boot)
    if [ "$PERSIST" = "1" ] && [ "$ON" = "1" ]; then
      # native engine: the system restores it itself (persist flag); sf engine: re-apply
      [ "$ENG" = "native" ] || apply
    else
      ON=0; save
      [ "$ENG" = "native" ] && native_set 0 "$LEVEL"
    fi
    mirror ;;
  reapply)
    [ "$ON" = "1" ] && [ "$ENG" != "native" ] && apply ;;
  reset)
    ON=0; apply; save; mirror; report ;;
  *)
    sed -n '/^#USAGE-START/,/^#USAGE-END/p' "$0" | sed '1d;$d;s/^# \{0,1\}//' ;;
esac
exit 0
